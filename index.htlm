<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Quiz ARMY: Hermandad Eterna 💜</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;1,500&family=Nunito:wght@400;700&display=swap">
<style>
:root{--bg:#f4edff;--surface:#fff;--ink:#2a1450;--muted:#6b568f;--p1:#7b2fd6;--p2:#b388ff;--p3:#e6d9ff;--ok:#2e9c6a;--no:#c4457a;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1b0d33;--surface:#2a1650;--ink:#f3eaff;--muted:#b9a3dd;--p1:#b388ff;--p2:#7b2fd6;--p3:#3c2270}}
:root[data-theme="dark"]{--bg:#1b0d33;--surface:#2a1650;--ink:#f3eaff;--muted:#b9a3dd;--p1:#b388ff;--p2:#7b2fd6;--p3:#3c2270}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font-family:Nunito,system-ui,sans-serif;line-height:1.5;min-height:100vh;
background-image:radial-gradient(circle at 15% 0,var(--p3),transparent 40%),radial-gradient(circle at 90% 100%,var(--p3),transparent 40%)}
main{max-width:560px;margin:0 auto;padding:20px 16px 40px}
h1,h2{font-family:Fraunces,Georgia,serif;margin:0}
h1{font-size:2.1rem;line-height:1.15;text-align:center;color:var(--p1)}
.hero{text-align:center;padding:12px 0 8px}
.hero p{color:var(--muted);margin:10px auto 18px;max-width:42ch}
.seven{display:flex;justify-content:center;gap:6px;margin:10px 0}
.seven svg{width:26px;height:26px;fill:var(--p1)}
.seven svg:nth-child(odd){fill:var(--p2)}
.logo{width:96px;height:96px;margin:0 auto}
.card{background:var(--surface);border:2px solid var(--p3);border-radius:22px;padding:20px;box-shadow:0 8px 30px rgba(123,47,214,.15)}
button{font:inherit;cursor:pointer}
.btn{display:block;width:100%;border:0;border-radius:999px;padding:14px;font-weight:700;color:#fff;background:linear-gradient(135deg,var(--p2),var(--p1));margin-top:14px}
:root[data-theme="dark"] .btn,:root:not([data-theme="light"]) .btn{color:#1b0d33}
.btn:focus-visible,.opt:focus-visible{outline:3px solid var(--p1);outline-offset:2px}
.bar{height:8px;background:var(--p3);border-radius:9px;overflow:hidden;margin-bottom:16px}
.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--p2),var(--p1));transition:width .4s}
.q{font-size:1.3rem;margin-bottom:14px}
.opt{display:block;width:100%;text-align:left;background:var(--bg);color:var(--ink);border:2px solid var(--p3);border-radius:14px;padding:12px 14px;margin-top:9px;transition:border-color .2s,transform .1s}
.opt:hover:not([disabled]){border-color:var(--p1)}
.opt.ok{border-color:var(--ok);background:rgba(46,156,106,.15)}
.opt.no{border-color:var(--no);background:rgba(196,69,122,.15)}
.fb{margin-top:12px;color:var(--muted);font-size:.95rem;min-height:1.4em}
.meta{display:flex;justify-content:space-between;color:var(--muted);font-size:.9rem;margin-bottom:6px}
.score{font-size:3rem;text-align:center;color:var(--p1);font-family:Fraunces,serif}
.res{text-align:center}
.hidden{display:none}
@media (prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<main>
<svg width="0" height="0" style="position:absolute"><defs>
<symbol id="heart" viewBox="0 0 24 24"><path d="M12 21s-8-5.2-8-11a4.6 4.6 0 0 1 8-3 4.6 4.6 0 0 1 8 3c0 5.800-8 11-8 11z"/></symbol>
</defs></svg>

<section id="start" class="hero">
  <svg class="logo" viewBox="0 0 100 100" role="img" aria-label="Corazón morado Borahae">
    <defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#c9a6ff"/><stop offset="1" stop-color="#7b2fd6"/></linearGradient></defs>
    <circle cx="50" cy="50" r="46" fill="none" stroke="url(#g)" stroke-width="3" stroke-dasharray="2 6" stroke-linecap="round"/>
    <path d="M50 78S24 61 24 42a14 14 0 0 1 26-7 14 14 0 0 1 26 7c0 19-26 36-26 36z" fill="url(#g)"/>
    <path d="M37 40l8 8 18-16" fill="none" stroke="#fff" stroke-width="0" />
  </svg>
  <div class="seven" aria-hidden="true"><svg><use href="#heart"/></svg><svg><use href="#heart"/></svg><svg><use href="#heart"/></svg><svg><use href="#heart"/></svg><svg><use href="#heart"/></svg><svg><use href="#heart"/></svg><svg><use href="#heart"/></svg></div>
  <h1>Quiz ARMY: Hermandad Eterna</h1>
  <p>Siete corazones, un solo vínculo. Demuestra cuánto conoces el amor que une a BTS y a ARMY.</p>
  <div class="card"><b>8 preguntas</b> sobre unión, apoyo y Borahae 💜
    <button class="btn" id="go">Empezar el quiz</button></div>
</section>

<section id="play" class="hidden">
  <div class="meta"><span id="n"></span><span id="s"></span></div>
  <div class="bar"><i id="bar"></i></div>
  <div class="card">
    <h2 class="q" id="q"></h2>
    <div id="opts"></div>
    <div class="fb" id="fb" aria-live="polite"></div>
    <button class="btn hidden" id="next">Siguiente</button>
  </div>
</section>

<section id="end" class="hidden res">
  <svg class="logo" viewBox="0 0 24 24" fill="#7b2fd6"><use href="#heart"/></svg>
  <div class="score" id="sc"></div>
  <h2 id="title"></h2>
  <p id="msg" style="color:var(--muted)"></p>
  <button class="btn" id="again">Jugar de nuevo</button>
</section>
</main>

<script>
const Q=[
{q:"¿Qué significa «Borahae» (보라해)?",o:["Te amo hasta el final","Te amo morado","Siempre juntos","Somos siete"],a:1,f:"V lo inventó: el morado es el último color del arcoíris, así que significa confiar y amar por mucho tiempo."},
{q:"¿En qué año nació oficialmente el nombre ARMY?",o:["2012","2013","2015","2017"],a:1,f:"El nombre ARMY (Adorable Representative M.C. for Youth) se anunció en 2013."},
{q:"¿Cuántos corazones forman BTS?",o:["Cinco","Seis","Siete","Ocho"],a:2,f:"RM, Jin, SUGA, j-hope, Jimin, V y Jungkook: siete miembros, siete corazones."},
{q:"¿Qué simboliza el ARMY Bomb (lightstick) en un concierto?",o:["Un mar morado de luz compartida","Solo un accesorio","El inicio del show","Un premio"],a:0,f:"Miles de luces sincronizadas forman el océano morado: la hermandad hecha visible."},
{q:"¿Qué hacen los ARMYs cuando un miembro o un compañero necesita apoyo?",o:["Se quedan al margen","Se unen, lo cuidan y lo animan","Esperan a que pase","Solo comentan"],a:1,f:"El apoyo mutuo, dentro y fuera de las redes, es el sello de la hermandad ARMY."},
{q:"¿Qué mensaje central comparte la campaña «Love Myself»?",o:["Gana más fama","Quiérete a ti mismo para poder querer a otros","Compite con todos","Evita sentir"],a:1,f:"Love Myself nació con UNICEF y habla de amor propio y de no rendirse."},
{q:"Entre ARMYs de países distintos, ¿qué idioma une a todos?",o:["Solo el coreano","Solo el inglés","El amor y la música","Ninguno"],a:2,f:"La música cruza fronteras: ARMY es una familia en todos los idiomas."},
{q:"«Siempre juntos» para ARMY significa…",o:["Solo en los buenos momentos","Mientras haya conciertos","En las buenas y en las malas, para siempre","Hasta el próximo comeback"],a:2,f:"Un amor eterno: ARMY y BTS se eligen cada día. 💜"}
];
const $=id=>document.getElementById(id);
let i=0,pts=0,done=false;
const show=id=>["start","play","end"].forEach(k=>$(k).classList.toggle("hidden",k!==id));
function load(){
  done=false;const c=Q[i];
  $("n").textContent=`Pregunta ${i+1} de ${Q.length}`;$("s").textContent=`💜 ${pts}`;
  $("bar").style.width=(i/Q.length*100)+"%";
  $("q").textContent=c.q;$("fb").textContent="";$("next").classList.add("hidden");
  $("opts").innerHTML="";
  c.o.forEach((t,k)=>{const b=document.createElement("button");b.className="opt";b.textContent=t;b.onclick=()=>pick(k);$("opts").appendChild(b)});
}
function pick(k){
  if(done)return;done=true;const c=Q[i];
  [...$("opts").children].forEach((b,j)=>{b.disabled=true;if(j===c.a)b.classList.add("ok");else if(j===k)b.classList.add("no")});
  if(k===c.a)pts++;
  $("s").textContent=`💜 ${pts}`;
  $("fb").textContent=(k===c.a?"¡Correcto! ":"Casi. ")+c.f;
  $("next").textContent=i===Q.length-1?"Ver resultado":"Siguiente";
  $("next").classList.remove("hidden");
}
$("go").onclick=()=>{i=0;pts=0;show("play");load()};
$("next").onclick=()=>{i++;if(i<Q.length)load();else finish()};
$("again").onclick=()=>{i=0;pts=0;show("play");load()};
function finish(){
  show("end");$("sc").textContent=`${pts} / ${Q.length}`;
  const r=pts>=7?["ARMY de corazón eterno","Tu hermandad brilla como un océano morado. Borahae. 💜"]:
  pts>=4?["ARMY en crecimiento","Tu amor ya se nota. Sigue sumando momentos con la familia. 💜"]:
  ["ARMY recién llegado","Todo gran vínculo empieza en algún punto. ¡Bienvenido a la familia! 💜"];
  $("title").textContent=r[0];$("msg").textContent=r[1];
}
</script>
</body>
</html>
